@page
@model hoohub.Pages.ArchiveModel
@{
    ViewData["Title"] = "Archive";
}

@section Styles {
    <link rel="stylesheet" href="~/css/archive.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()

<img id="banner" class="mb-md-4 d-block m-auto animate__animated animate__fadeIn animate__fast" src="~/img/hoo_banner.png" />
<input id="archive-query" class="form-control mx-auto mb-2" asp-for="@Model.TagInput" title="Enter tags, number or the name of a comic" />
<div id="archive-items" class="row mx-auto mt-4 justify-content-center">
</div>

@section Scripts {
    <script type="text/javascript" src="~/js/archive.js" asp-append-version="true"></script>
}