@page
@using hoohub.Enums
@using hoohub.Services
@model hoohub.Pages.Manage.IndexModel
@{
    ViewData["Title"] = "Manage";
    var placeholderPath = Model.IsNightMode ? "hoo_logo_placeholder_night.png" : "hoo_logo_placeholder.png";
}

@section Styles {
    <link rel="stylesheet" href="~/css/manage.css" asp-append-version="true"/>
}

@Html.AntiForgeryToken()

<div class="container content-panel animate__animated animate__fadeIn">
    <div class="row vw-75 mx-auto">
        <div role="button" tabindex="0" data-tab-id="0" class="col-auto tab-header selected" onclick="switchTab(0)">
            <span>New comic</span>
        </div>
        <div role="button" tabindex="0" data-tab-id="1" class="col-auto tab-header" onclick="switchTab(1);getManageComicsList($('#manage-comics-refresh'))">
            <span>Manage comics</span>
        </div>
        <div role="button" tabindex="0" data-tab-id="3" class="col-auto tab-header" onclick="switchTab(3)">
            <span>Me</span>
        </div>
        <div role="button" tabindex="0" data-tab-id="4" class="col-auto tab-header" onclick="switchTab(4);getEvents($('#logs-update'))">
            <span>Events</span>
        </div>
    </div>
    <div class="row">
        <div data-tab-id="0" class="container tab-body selected">
            <div class="row">
                <div class="col">
                    <h5 class="text-center mb-2">Preview</h5>
                    <img 
                        id="new-comic-preview" 
                        title="Upload a comic..." 
                        class="animate__animated animate__fadeIn" 
                        src="~/img/@(placeholderPath)"
                         data-placeholder="@($@"data:image/jpg;base64, {(Model.IsNightMode ? Properties.Resources.UploadPlaceholderBase64 : Properties.Resources.UploadPlaceholderNightBase64)}")" onclick="$('#new-comic-image-data').click()" />
                    <br />
                    <span asp-validation-for="ManageInputModel.NewComicInput.ImageData" class="text-warning"></span>
                </div>
                <div class="col">
                    <form id="new-comic-form" class="w-75 mx-auto" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                        <div class="form-group">
                            <input class="d-none" id="new-comic-image-data" asp-for="ManageInputModel.NewComicInput.ImageData" accept=".png,.jpg,.jpeg,.gif"/>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="ManageInputModel.NewComicInput.ComicNumber"></label>
                            <input id="new-comic-comic-number" asp-for="ManageInputModel.NewComicInput.ComicNumber" class="form-control" />
                            <span asp-validation-for="ManageInputModel.NewComicInput.ComicNumber" class="text-warning"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="ManageInputModel.NewComicInput.ComicTitle"></label>
                            <input id="new-comic-comic-title" asp-for="ManageInputModel.NewComicInput.ComicTitle" class="form-control" />
                            <span asp-validation-for="ManageInputModel.NewComicInput.ComicTitle" class="text-warning"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="ManageInputModel.NewComicInput.ComicDescription"></label>
                            <input id="new-comic-comic-description" asp-for="ManageInputModel.NewComicInput.ComicDescription" class="form-control" />
                            <span asp-validation-for="ManageInputModel.NewComicInput.ComicDescription" class="text-warning"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="ManageInputModel.NewComicInput.Tags"></label>
                            <input id="new-comic-comic-tags" asp-for="ManageInputModel.NewComicInput.Tags" class="form-control" />
                            <span asp-validation-for="ManageInputModel.NewComicInput.Tags" class="text-warning"></span>
                        </div>
                        <div class="row">
                            <label class="form-label" asp-for="ManageInputModel.NewComicInput.IsHidden"></label>
                        </div>
                        <div class="row">
                            <label class="switch form-group scale-75">
                                <input id="new-comic-is-hidden" type="checkbox" onclick="toggleComicIsHidden(this, 'new')">
                                <span class="slider"></span>
                            </label>
                        </div>
                        <div class="row">
                            <div class="col-auto">
                                <div class="row">
                                    <label class="form-label" asp-for="ManageInputModel.NewComicInput.IsScheduled"></label>
                                </div>
                                <div class="row">
                                    <label class="switch form-group justify-content-center scale-75">
                                        <input id="new-comic-is-scheduled" type="checkbox" onclick="toggleComicIsScheduled(this, 'new')">
                                        <span class="slider"></span>
                                    </label>
                                </div>
                            </div>
                            <div class="col">
                                <div id="new-comic-schedule-details" class="form-group" style="display: none">
                                    <label class="form-label" asp-for="ManageInputModel.NewComicInput.ScheduleFor"></label>
                                    <input id="new-comic-schedule-for" asp-for="ManageInputModel.NewComicInput.ScheduleFor" type="datetime-local" class="form-control" readonly/>
                                    <span asp-validation-for="ManageInputModel.NewComicInput.ScheduleFor" class="text-warning"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4 d-flex justify-content-center mx-auto">
                            <div class="col-auto mx-auto">
                                <div role="button" tabindex="0" class="site-option option-button material-symbols-outlined align-items-center justify-content-center box-shadow" onclick="postNewComic(this)" title="Publish">history_edu</div>
                                <br />
                                <span class="option-tip">Publish</span>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div data-tab-id="1" class="container tab-body">
            <div class="row overflow-hidden">
                <div class="col overflow-hidden">
                    <h5 id="manage-comics-count" class="mb-1 box-">Displaying X comics</h5>
                    <div id="manage-comics-list">
                    </div>
                    <div class="row mt-4 d-flex justify-content-center mx-auto">
                        <div class="col-auto mx-auto">
                            <div role="button" tabindex="0" id="manage-comics-refresh" class="site-option option-button material-symbols-outlined align-items-center justify-content-center box-shadow" onclick="getManageComicsList(this)" title="Refresh">refresh</div>
                            <br />
                            <span class="option-tip">Refresh</span>
                        </div>
                    </div>
                </div>
                <div class="col mx-auto overflow-auto">
                    <div class="row">
                        <div class="col-auto mx-auto">
                            <img 
                                id="manage-comic-preview" 
                                title="Upload a comic..." 
                                class="animate__animated animate__fadeIn" 
                                src="~/img/@(placeholderPath)"
                                 data-placeholder="@($@"data:image/jpg;base64, {(Model.IsNightMode ? Properties.Resources.UploadPlaceholderNightBase64 : Properties.Resources.UploadPlaceholderBase64)}")"
                                 onclick="manageComicPreviewClick()" />
                            <br />
                            <span asp-validation-for="ManageInputModel.ManageComicInput.ImageData" class="text-warning"></span>
                        </div>
                        <div class="col mx-auto">
                            <form id="manage-comic-form" class="w-100 mx-auto" enctype="multipart/form-data">
                                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                                <div class="form-group">
                                    <input class="d-none" id="manage-comic-image-data" asp-for="ManageInputModel.ManageComicInput.ImageData" accept=".png,.jpg,.jpeg,.gif" />
                                </div>
                                <div class="form-group">
                                    <input id="manage-comic-comic-guid" asp-for="ManageInputModel.ManageComicInput.ComicGuid" class="form-control" type="hidden" />
                                    <span asp-validation-for="ManageInputModel.ManageComicInput.ComicGuid" class="text-warning"></span>
                                </div>
                                <div class="form-group">
                                    <label class="form-label" asp-for="ManageInputModel.ManageComicInput.ComicNumber"></label>
                                    <input id="manage-comic-comic-number" asp-for="ManageInputModel.ManageComicInput.ComicNumber" class="form-control" />
                                    <span asp-validation-for="ManageInputModel.ManageComicInput.ComicNumber" class="text-warning"></span>
                                </div>
                                <div class="form-group">
                                    <label class="form-label" asp-for="ManageInputModel.ManageComicInput.ComicTitle"></label>
                                    <input id="manage-comic-comic-title" asp-for="ManageInputModel.ManageComicInput.ComicTitle" class="form-control" />
                                    <span asp-validation-for="ManageInputModel.ManageComicInput.ComicTitle" class="text-warning"></span>
                                </div>
                                <div class="form-group">
                                    <label class="form-label" asp-for="ManageInputModel.ManageComicInput.ComicDescription"></label>
                                    <input id="manage-comic-comic-description" asp-for="ManageInputModel.ManageComicInput.ComicDescription" class="form-control" />
                                    <span asp-validation-for="ManageInputModel.ManageComicInput.ComicDescription" class="text-warning"></span>
                                </div>
                                <div class="form-group">
                                    <label class="form-label" asp-for="ManageInputModel.ManageComicInput.Tags"></label>
                                    <input id="manage-comic-comic-tags" asp-for="ManageInputModel.ManageComicInput.Tags" class="form-control" />
                                    <span asp-validation-for="ManageInputModel.ManageComicInput.Tags" class="text-warning"></span>
                                </div>
                                <div class="form-group">
                                    <label class="form-label" asp-for="ManageInputModel.ManageComicInput.IsHidden"></label>
                                    <br />
                                    <label class="switch row justify-content-center scale-75">
                                        <input id="manage-comic-is-hidden" type="checkbox" onclick="toggleComicIsHidden(this, 'manage')">
                                        <span class="slider"></span>
                                    </label>
                                </div>
                                <div class="form-group">
                                    <div class="row">
                                        <div class="row">
                                            <label class="form-label" asp-for="ManageInputModel.ManageComicInput.IsScheduled"></label>
                                        </div>
                                        <div class="row">
                                            <label class="switch form-group justify-content-center scale-75">
                                                <input id="manage-comic-is-scheduled" type="checkbox" onclick="toggleComicIsScheduled(this, 'manage')">
                                                <span class="slider"></span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div id="manage-comic-schedule-details" class="form-group">
                                            <label class="form-label" asp-for="ManageInputModel.ManageComicInput.ScheduleFor"></label>
                                            <input id="manage-comic-schedule-for" asp-for="ManageInputModel.ManageComicInput.ScheduleFor" type="datetime-local" class="form-control" readonly />
                                            <span asp-validation-for="ManageInputModel.ManageComicInput.ScheduleFor" class="text-warning"></span>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="row mt-4 d-flex justify-content-center mx-auto">
                        <div class="col-auto mx-auto">
                            <div role="button" tabindex="0" id="manage-comic-update" class="site-option option-button material-symbols-outlined align-items-center justify-content-center box-shadow disabled" onclick="patchComic(this)" title="Update">update</div>
                            <br />
                            <span class="option-tip">Update</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div data-tab-id="3" class="container tab-body">
            <div class="container mx-auto my-auto">
                <form id="manage-me-form" class="w-50 mx-auto" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <img id="manage-me-preview" title="Upload a display picture..." class="animate__animated animate__fadeIn" src="@($@"data:image/jpg;base64, {Model.DisplayPictureOnLoad}")" data-placeholder="@($@"data:image/jpg;base64, {Model.DisplayPictureOnLoad}")" onclick="$('#manage-me-image-data').click()" />
                    <br />
                    <span asp-validation-for="ManageInputModel.ManageMeInput.ImageData" class="text-warning"></span>

                    <div class="form-group">
                        <input class="d-none" id="manage-me-image-data" asp-for="ManageInputModel.ManageMeInput.ImageData" accept=".png,.jpg,.jpeg,.gif" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="ManageInputModel.ManageMeInput.Handle"></label>
                        <input id="manage-me-handle" asp-for="ManageInputModel.ManageMeInput.Handle" class="form-control w-75"/>
                        <span asp-validation-for="ManageInputModel.ManageMeInput.Handle" class="text-warning"></span>
                    </div>
                </form>
                <div class="row mt-4 d-flex justify-content-center mx-auto">
                    <div class="col-auto mx-auto">
                        <div role="button" tabindex="0" class="site-option option-button material-symbols-outlined align-items-center justify-content-center box-shadow" onclick="patchProfile(this)" title="Update">update</div>
                        <br />
                        <span class="option-tip">Update</span>
                    </div>
                </div>
            </div>
        </div>
        <div data-tab-id="4" class="container tab-body">
            <div class="row overflow-hidden">
                <h5 id="manage-events-count" class="mb-1 box-">Displaying X events</h5>
                <div id="manage-events-list">
                </div>
                <div class="row mt-4 d-flex justify-content-center mx-auto">
                    <div class="col-auto mx-auto">
                        <div role="button" tabindex="0" id="logs-update" class="site-option option-button material-symbols-outlined align-items-center justify-content-center box-shadow" onclick="getEvents(this)" title="Refresh">sync</div>
                        <br />
                        <span class="option-tip">Refresh</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript" src="~/js/manage.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
}