@page
@model IndexModel
@{
    ViewData["Title"] = "Hoo.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/comics.css" />
}

<div id="comic-menu">
    <div class="container">
        <div class="row site-option material-symbols-outlined align-items-center justify-content-center box-shadow mb-4" title="Get link" onclick="copyToClipboard('@Url.PageLink(pageName: "/Index", values: new { comic = Model.Comic.Id})')">link</div>
        <div class="row site-option material-symbols-outlined align-items-center justify-content-center box-shadow mt-2" title="Next comic...">fast_forward</div>
        <div class="row site-option material-symbols-outlined align-items-center justify-content-center box-shadow mt-2" title="Previous comic...">fast_rewind</div>
        <div class="row site-option material-symbols-outlined align-items-center justify-content-center box-shadow mt-2" title="Random comic...">shuffle</div>
        
    </div>
</div>

<div class="container content-panel text-center">
    <img id="banner" class="mb-md-2 d-block m-auto animate__animated animate__fadeIn animate__fast" src="~/img/hoo_banner.png" />
    @if (Model.Comic != null)
    {
        string imageSource = Model.Comic != null ? $@"data:image/jpg;base64, {Model.Comic.GetImageAsBase64String()}" : "~/img/notfound.png";
        <img id="comic-display" class="d-block m-auto animate__animated animate__fadeIn animate__fast" src="@(imageSource)" />
    }
    else
    {
        <h4 class="text-center animate__animated animate__fadeIn animate__fast">Doodle not found</h4>
    }
</div>