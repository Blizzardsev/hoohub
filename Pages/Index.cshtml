@page
@model IndexModel
@{
    ViewData["Title"] = "Hoo.";
}

<div class="container position-absolute top-2">
    <img id="banner" class="mb-md-4 d-block m-auto" src="~/img/hoo_banner.png" />
</div>
<div class="container position-absolute top-25 mb-2 mt-2">
    @if (Model.Comic != null)
    {
        string imageSource = Model.Comic != null ? $@"data:image/jpg;base64, {Model.Comic.GetImageAsBase64String()}" : "~/img/notfound.png";
        <img id="comic-display" class="d-block m-auto animate__animated animate__fadeIn animate__fast" src="@(imageSource)" />
    }
    else
    {
        <h4 class="text-center animate__animated animate__fadeIn animate__fast">Doodle not found</h4>
    }
</div>
