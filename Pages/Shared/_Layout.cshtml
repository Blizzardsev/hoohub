@inject SignInManager<HooHubUser> _signInManager
@inject UserManager<HooHubUser> _userManager

@{
    var signedIn = _signInManager.IsSignedIn(User);
    var user = _userManager.GetUserAsync(User).Result;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hate everything.</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/hoohub.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/material-symbols/index.css" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Trocchi&display=swap" rel="stylesheet">
    @RenderSection("Styles", required: false)
</head>
<div class="background-stripe"></div>
<body>
    <header>
        <a asp-page="/Index">
            <img id="logo" class="d-inline-block mb-2 mt-2" src="~/img/hoo_logo_alt.png" />
        </a>
        <span id="site-nav" class="navbar-option interactive material-symbols-outlined align-middle" onclick="toggleMenu(this)">menu</span>
    </header>

    <div id="site-menu">
        <div class="container box-shadow">
            <img src="~/img/hoo_logo_no_tagline.png" />
            <a asp-page="/Index">
                <div class="row site-option material-symbols-outlined align-items-center justify-content-center box-shadow" title="Home">home</div>
            </a>
            <a asp-page="/Archive">
                <div class="row site-option material-symbols-outlined align-items-center justify-content-center box-shadow mt-2" title="Archive">grid_on</div>
            </a>
            @if (!signedIn)
            {
                <a asp-page="/Manage/Index">
                    <div class="row site-option material-symbols-outlined align-items-center justify-content-center box-shadow mt-2" title="Manage">settings</div>
                </a>
                <a asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Account/Logout")">
                    <div class="row site-option mt-4 material-symbols-outlined align-items-center justify-content-center box-shadow" title="Log out">logout</div>
                </a>
            }
            else
            {
                <a asp-page="/Account/Login" asp-route-returnUrl="@Url.Page("/Account/Login")">
                    <div class="row site-option mt-4 material-symbols-outlined align-items-center justify-content-center box-shadow" title="Log in">login</div>
                </a>
            }
        </div>
    </div>

    <img class="pfp-roundel" style="width: 48px;" src="https://pbs.twimg.com/profile_images/1818811622338494464/YzQZoSDH_400x400.png" />
    
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted">
        <div class="container text-center mx-auto">
            <span class="footer-item">Contact</span>
            <span class="footer-item">Cookies</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>