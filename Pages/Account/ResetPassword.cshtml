@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="container content-panel text-center animate__animated animate__fadeIn">
    <h1 class="text-center mb-4">Set your new password</h1>
    <form method="post">
        <input asp-for="Input.Code" type="hidden" />
        <div class="row d-flex justify-content-center text-center mx-auto w-75">
            <div class="form-group">
                <input asp-for="Input.Login" class="form-control" autocomplete="new-email" aria-required="true" />
                <span asp-validation-for="Input.Login" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        </div>
        <div class="row mt-2 d-flex justify-content-center mx-auto">
            <div class="col d-inline">
                <div onclick="identitySubmit(this)" class="site-option option-button material-symbols-outlined align-items-center justify-content-center box-shadow">keyboard_double_arrow_right</div>
                <br />
                <span class="option-tip">Continue</span>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script type="text/javascript" src="~/js/identity.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
}