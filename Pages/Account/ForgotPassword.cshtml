@page
@model ForgotPasswordModel
@{
    var passwordContextTitle = Model.IsFirstTimeLogin ? "Set password" : "Forgotten password";
    ViewData["Title"] = passwordContextTitle;
}

<div class="container content-panel text-center animate__animated animate__fadeIn">
    <h1 class="text-center mb-4">@(passwordContextTitle)</h1>
    <h5 class="mb-4">Enter your email address to @(Model.IsFirstTimeLogin ? "set" : "reset") your password</h5>
    <form method="post">
        <div class="row d-flex justify-content-center text-center mx-auto w-75">
            <div class="form-group">
                <input asp-for="Input.Login" class="form-control" autocomplete="username" aria-required="true" />
            </div>
        </div>
        <div class="row mt-2 d-flex justify-content-center mx-auto">
            <div class="col d-inline">

                <div role="button" tabindex="0" onclick="identitySubmit(this)" class="site-option option-button material-symbols-outlined align-items-center justify-content-center box-shadow">keyboard_double_arrow_right</div>
                <br />
                <span class="option-tip">Continue</span>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script type="text/javascript" src="~/js/identity.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
}
