@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Check your email";
}

<div class="container content-panel text-center">
    <h3 class="text-center mb-4">Password reset sent</h3>
    <h5 class="mb-4">Check your email for the link to reset your password</h5>
    <div class="row mt-2 d-flex justify-content-center mx-auto">
        <div class="col d-inline">
            <a asp-page="Login">
                <div class="site-option option-button material-symbols-outlined align-items-center justify-content-center box-shadow">keyboard_double_arrow_right</div>    
            </a>
            <br />
            <span class="option-tip">Continue</span>
        </div>
    </div>
</div>