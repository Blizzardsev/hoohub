@page
@model LoginModel

@{
    ViewData["Title"] = "Hoo's there?";
}
@section Styles {
    <link rel="stylesheet" href="~/css/identity.css" />
}

<div class="container position-absolute top-25">
    <h2 class="text-center mb-4">Hoo's there?</h2>
    
    <form id="account" method="post">
        <div class="row d-flex justify-content-center text-center mx-auto w-75">
            <div class="col row align-content-center">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-group">
                    <input asp-for="Input.Email" class="form-control" autocomplete="new-email" aria-required="true" />
                </div>
                <div class="form-group">
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" />
                </div>
            </div>
            <div class="col">
                <img id="comic-display" class="d-block m-auto mb-2 mt-2" style="max-height: 300px" src="~/img/hoo_squint.png" asp-append-version=true />
            </div>
        </div>
        <div class="row mt-2 mb-4 d-flex justify-content-center mx-auto">
            <div class="col d-inline">
                <div onclick="identitySubmit(this)" class="site-option option-button material-symbols-outlined align-items-center justify-content-center box-shadow">keyboard_double_arrow_right</div>
                <br />
                <span class="option-tip">Log in</span>
            </div>
        </div>
    </form>
    <h5 class="text-center">Forgotten password?</h5>
</div>

@section Scripts {
    <script type="text/javascript" src="~/js/identity.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
}
