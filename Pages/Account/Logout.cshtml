@page
@model LogoutModel
@{
    ViewData["Title"] = "Hootbye";
}

<div class="container content-panel text-center">
    <h1 class="text-center mb-4">Hootbye...</h1>
    <br />
    <img id="comic-display" class="d-block m-auto mb-2 mt-2" style="max-height: 50vh" src="~/img/hootbye.png" asp-append-version=true onload="resetRedirect(300000000)"/>
    <h5 class="text-center mt-4">Redirecting...</h5>
    <div class="loader mt-2 mb-2"></div>
</div>