@inject SignInManager<HooHubUser> _signInManager
@inject UserManager<HooHubUser> _userManager

@{
    var signedIn = _signInManager.IsSignedIn(User);
    var user = _userManager.GetUserAsync(User).Result;
    var displayPicture = user != null ? $@"data:image/jpg;base64,{Convert.ToBase64String(user.DisplayPicture)}" : "~/img/notfound.png";

    var isNightMode = Context.Request.Cookies["nightMode"] == "true";
    var logoPath = isNightMode ? "hoo_logo_alt_night.png" : "hoo_logo_alt.png";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hate everything.</title>

    <meta content="@ViewData["Title"] - Hate everything." property="og:title" />
    <meta content="The (mis)adventures of an unfortunate little owl." property="og:description" />
    <meta content="@returnUrl" property="og:url" />
    <meta content="~/img/hoo_embed.png" property="og:image" />
    <meta content="#ED7454" data-react-helmet="true" name="theme-color" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/hoohub.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/material-symbols/index.css" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Trocchi&display=swap">

    @RenderSection("Styles", required: false)

    <!--Theme styles based on night/day-->
    <style>
        :root {
            --main-foreground-colour: @(isNightMode ? "#fff" : "#280501");
            --main-background-colour: @(isNightMode ? "#0b0128" : "#fff");
            --scrollbar-color: @(isNightMode ? "#fff #4f456e" : "#280501 #DFDAD9");

            --loader-background-a: @(isNightMode ? "#7285BB" : "#280501");
            --loader-background-b: @(isNightMode ? "#BDC7E5" : "#84706D");
            --loader-background-c: @(isNightMode ? "#F9E2CA" : "#DFDAD9");

            --site-nav-foreground-colour: @(isNightMode ? "#fff" : "#0b0128");
            --site-menu-background-colour: @(isNightMode ? "#4f456e" : "#fff");
            --site-option-foreground-colour: @(isNightMode ? "#fff" : "#fff");
            --site-option-background-colour: @(isNightMode ? "#4f456e" : "#0b0128");
            --slider-selected-colour: @(isNightMode ? "#4f456e" : "#280501");

            --input-foreground-colour: @(isNightMode ? "#fff" : "#280501");
            --input-background-colour: @(isNightMode ? "#4f456e" : "#ddd7d6");
            --input-read-only-background-color: @(isNightMode ? "#2d273f !important" : "#84706D !important");
            --validation-warning-foreground-color: @(isNightMode ? "#fcd023 !important" : "#963636 !important");

            --footer-item-foreground-colour: @(isNightMode ? "#fff" : "#fff");
            --footer-item-background-colour: @(isNightMode ? "#4f456e" : "#1e1e1e");

            --site-alert-foreground-colour: @(isNightMode ? "#fff" : "#fff");
            --site-alert-background-colour: @(isNightMode ? "rgba(60,52,83,90%)" : "rgba(40,5,1,90%)");

            --athena-filter: @(isNightMode ? "grayscale(100) brightness(100)" : "none");
            
            --loading-container-background: @(isNightMode ? "rgba(60,52,83,90%)" : "rgba(40,5,1,90%)");
            
            --archive-comic-view-container-background: @(isNightMode ? "rgba(60,52,83,90%)" : "rgba(40,5,1,90%)");
            
            --list-item-foreground-colour: @(isNightMode ? "#fff" : "#808080");
            --list-item-background-colour: @(isNightMode ? "transparent" : "#fff");
            
            --tab-header-foreground-colour: @(isNightMode ? "#8c82b0" : "#84706D");
            --tab-header-background-colour: @(isNightMode ? "#2d273f" : "#DFDAD9");
            --tab-header-border: @(isNightMode ? "2px solid #2d273f" : "2px solid #DFDAD9");
            --tab-header-selected-foreground-colour: @(isNightMode ? "#fff" : "#fff");
            --tab-header-selected-background-colour: @(isNightMode ? "#4f456e" : "#280501");
            --tab-header-selected-border-colour: @(isNightMode ? "#4f456e" : "#280501");
            
            --tab-body-border: @(isNightMode ? "2px solid #4f456e" : "2px solid #280501");
        }
    </style>
</head>
<div class="background-stripe"></div>
<body>
    <header>
        <a asp-page="/Index">
            <img role="button" tabindex="0" id="logo" class="d-inline-block mb-2 mt-2" src="~/img/@(logoPath)" />
        </a>
        <span id="site-nav" class="navbar-option interactive material-symbols-outlined align-middle mb-2 mt-2" onclick="toggleMenu(this)">menu</span>
    </header>

    <div id="site-menu">
        <div class="container box-shadow">
            <img src="~/img/hoo_logo_no_tagline.png" />
            <a asp-page="/Index">
                <div role="button" tabindex="0" class="row site-option material-symbols-outlined align-items-center justify-content-center box-shadow" title="Home">home</div>
            </a>
            <a asp-page="/Archive">
                <div class="row site-option material-symbols-outlined align-items-center justify-content-center box-shadow mt-2" title="Archive">grid_on</div>
            </a>
            @if (signedIn)
            {
                <a asp-page="/Manage/Index">
                    <div role="button" tabindex="0" class="row site-option material-symbols-outlined align-items-center justify-content-center box-shadow mt-2" title="Manage">settings</div>
                </a>
                <a asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Account/Logout")">
                    <div role="button" tabindex="0" class="row site-option mt-4 material-symbols-outlined align-items-center justify-content-center box-shadow" title="Log out">logout</div>
                </a>
            }
            else
            {
                <a asp-page="/Account/Login" asp-route-returnUrl="@Url.Page("/Account/Login")">
                    <div role="button" tabindex="0" class="row site-option mt-4 material-symbols-outlined align-items-center justify-content-center box-shadow" title="Log in">person</div>
                </a>
            }
            <a asp-page="/Index" asp-page-handler="ToggleNightMode" asp-route-returnUrl="@returnUrl">
                @{
                    var modeTitle = $"Switch to {(isNightMode ? "day" : "night")} mode";
                    var modeMaterialIcon = isNightMode ? "clear_day" : "mode_night";
                }
                <div role="button" tabindex="0" class="row site-option mt-4 material-symbols-outlined align-items-center justify-content-center box-shadow" title="@(modeTitle)">@(modeMaterialIcon)</div>
            </a>
        </div>
    </div>

    @if (signedIn && User.Identity.IsAuthenticated)
    {
        <img class="pfp-roundel" style="width: 48px;" src="@(displayPicture)" title="Signed in as @user.Handle"/>
    }
    
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted">
        <div class="container text-center mx-auto">
            <span role="button" tabindex="0" class="footer-item" title="Contact us..."><img class="twitter" src="~/img/twitter.png" /><a href="https://x.com/HooDoodles" target="_blank">Contact</a></span>
            <span role="button" tabindex="0" class="footer-item" title="About us..."><a asp-page="/About">About</a></span>
            <span role="button" tabindex="0" class="footer-item" title="Cookies..."><a asp-page="/Cookies">Cookies</a></span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>