@page
@model IndexModel

@{
    ViewData["Title"] = "Hoo.";
    var bannerPath = Model.IsNightMode ? "hoo_banner_night.png" : "hoo_banner.png";
    var comicImageSource = Model.Comic != null ? $@"data:image/jpg;base64, {Model.Comic.GetImageAsBase64String()}" : "~/img/notfound.png";
    var comicNotFoundClass = Model.Comic == null ? "athena" : string.Empty;
}

@section Styles {
    <link rel="stylesheet" href="~/css/comics.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()

@if (Model.Comic != null)
{
    var uploaderDisplayPicture = Model.Comic.UploadedBy != null && Model.Comic.UploadedBy.DisplayPicture != null
        ? $@"data:image/jpg;base64,{Convert.ToBase64String(Model.Comic.UploadedBy.DisplayPicture)}" 
        : "~/img/notfound.png";

    <div 
        role="button"
        tabindex="0"
        id="about-comic" 
        class="about-comic-view-container animate__animated animate__fadeIn animate__faster" 
        onclick="hideModal('about-comic')"
        onkeypress="onEnterKeyPress(event, hideModal, 'about-comic')"
        style="display: none">
        <div class="about-comic-view-content">
            <h2>@Model.Comic.GetComicDisplayName()</h2>
            <input id="about-comic-publish-date-info" type="hidden" value="@(Model.Comic.PublishDate.HasValue? Model.Comic.PublishDate.Value.ToString("yyyy-MM-ddTHH:mm:ss.fffZ") : string.Empty)" />
            <h5 id="about-comic-publish-date-display" class="fst-italic mb-4">First published (Unknown)</h5>

            @if (Model.Comic.UploadedBy != null)
            {
                <img class="mb-4" src="@(uploaderDisplayPicture)" alt="Uploaded by @(Model.Comic.UploadedBy.Handle)">
                <h5 class="fst-italic mb-2">Uploaded by @(Model.Comic.UploadedBy.Handle)</h5>
            }

            <h5 class="fst-italic mt-4">@Model.Comic.GetComicDisplayDescription(false)</h5>
            <h5 class="fst-italic">Tags | @Model.Comic.GetComicDisplayTags()</h5>

            <h5 class="fst-italic mt-5 opacity-50">Click anywhere to dismiss</h5>
        </div>
    </div>

    <div 
        role="button"
        tabindex="0"
        id="view-comic-full" 
        class="full-comic-view-container animate__animated animate__fadeIn animate__faster" 
        onclick="hideModal('view-comic-full')" 
        onkeypress="onEnterKeyPress(event, hideModal, 'view-comic-full')"
        style="display: none">
        <div class="full-comic-view-content">
            <img 
                id="view-comic-full-display" 
                class="d-block m-auto animate__animated animate__fadeIn animate__fast @(comicNotFoundClass)"
                src="@(comicImageSource)" 
                alt="@Model.Comic.ComicAltDescription"
                title="Click anywhere to dismiss..."/>
            <h5 class="fst-italic mt-2 opacity-50">Click anywhere to dismiss</h5>
        </div>
    </div>
}

<div id="comic-menu">
    <div class="container">
        @if(Model.Comic != null)
        {
            <div 
                role="button" 
                tabindex="0" 
                class="row site-option material-symbols-outlined align-items-center justify-content-center box-shadow" 
                title="Get link" 
                onclick="copyToClipboard('@Url.PageLink(pageName: "/Index", values: new { comic = Model.Comic.Id })')"
                onkeydown="onEnterKeyPress(event, copyToClipboard, '@Url.PageLink(pageName: "/Index", values: new { comic = Model.Comic.Id })')">
                link
            </div>
            <div 
                role="button" 
                tabindex="0" 
                class="row site-option material-symbols-outlined align-items-center justify-content-center box-shadow mt-2" 
                title="Comic info..." 
                onclick="showModal('about-comic')"
                onkeydown="onEnterKeyPress(event, showModal, 'about-comic')">
                info
            </div>
            
            <div class="row">
                <div class="col align-content-center">
                    <div id="comic-like"
                         role="button"
                         tabindex="0"
                         class="row site-option material-symbols-outlined align-items-center justify-content-center box-shadow mt-2 mb-4 @(Model.ComicIsLiked ? "heart" : string.Empty)"
                         title="@(Model.ComicIsLiked ? "Unlike this comic..." : "Like this comic!")"
                         onclick="heartComic(this, '@(Model.Comic.Id)')"
                         onkeydown="onEnterKeyPress(event, heartComic, this, '@(Model.Comic.Id)')">
                        favorite
                    </div>
                </div>
                <div class="col align-content-center">
                    <p id="comic-like-count" class="heart box-shadow d-none">@(Model.Comic.ComicLikes.Count)</p>
                </div>
            </div>
        }

        @if (Model.Comic != null && !string.IsNullOrWhiteSpace(Model.NextComicId))
        {
            <a asp-page="/Index" asp-route-comic="@Model.NextComicId">
                <div role="button" tabindex="0" class="row site-option material-symbols-outlined align-items-center justify-content-center box-shadow mt-2" title="Next comic...">fast_forward</div>
            </a>
        }
        else
        {
            <div role="button" tabindex="0" class="row site-option disabled material-symbols-outlined align-items-center justify-content-center box-shadow mt-2">fast_forward</div>
        }

        @if (Model.Comic != null && !string.IsNullOrWhiteSpace(Model.PreviousComicId))
        {
            <a asp-page="/Index" asp-route-comic="@Model.PreviousComicId">
                <div role="button" tabindex="0" class="row site-option material-symbols-outlined align-items-center justify-content-center box-shadow mt-2" title="Previous comic...">fast_rewind</div>
            </a>
        }
        else
        {
            <div role="button" tabindex="0" class="row site-option disabled material-symbols-outlined align-items-center justify-content-center box-shadow mt-2">fast_rewind</div>
        }
        
        <a asp-page="/Index" asp-page-handler="RandomComic" asp-route-currentComic="@(Model.Comic != null ? Model.Comic.Id : string.Empty)">
            <div role="button" tabindex="0" class="row site-option material-symbols-outlined align-items-center justify-content-center box-shadow mt-2 mb-2" title="Random comic...">shuffle</div>
        </a>

        <a asp-page="/Index" asp-page-handler="FirstComic">
            <div role="button" tabindex="0" class="row site-option material-symbols-outlined align-items-center justify-content-center box-shadow mt-4" title="Jump to start...">history</div>
        </a>
        <a asp-page="/Index" asp-page-handler="LastComic">
            <div role="button" tabindex="0" class="row site-option material-symbols-outlined align-items-center justify-content-center box-shadow mt-2" title="Jump to end...">update</div>
        </a>
    </div>
</div>

<div class="container content-panel text-center">
    <img id="banner" class="mt-2 mb-2 d-block m-auto animate__animated animate__fadeIn animate__fast" src="~/img/@(bannerPath)" alt="Hoo - Hate everything."/>
    @if (Model.Comic != null)
    {
        <img 
            id="comic-display" 
            class="d-block m-auto animate__animated animate__fadeIn animate__fast @(comicNotFoundClass)" 
            src="@(comicImageSource)" 
            alt="@Model.Comic.ComicAltDescription"
            title="Click comic to enlarge..."
            onclick="showModal('view-comic-full')"
            onkeypress="onEnterKeyPress(event, showModal, 'view-comic-full')" />
    }
    else
    {
        <h4 class="text-center animate__animated animate__fadeIn animate__fast">Doodle not found</h4>
    }
</div>

@section Scripts {
    <script type="text/javascript" src="~/js/comics.js" asp-append-version="true"></script>
    <script src="@("https://cdn.jsdelivr.net/npm/@tsparticles/confetti@3.0.3/tsparticles.confetti.bundle.min.js")"></script>
    <partial name="_ValidationScriptsPartial" />
}