@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password reset";
}

<div class="container content-panel text-center animate__animated animate__fadeIn">
    <h1 class="text-center mb-4">Password reset</h1>
    <br />
    <img id="comic-display" class="d-block m-auto mb-2 mt-2 athena" style="max-height: 50vh" src="~/img/pop.png" asp-append-version=true onload="resetRedirect(3000)" />
    <h5 class="text-center mt-4">Your password has been reset. Redirecting...</h5>
    <div class="loader mt-2 mb-2"></div>
</div>

@section Scripts {
    <script src="~/js/logout.js" asp-append-version="true"></script>
}