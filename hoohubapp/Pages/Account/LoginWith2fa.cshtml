@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Hoo-factor authentication required";
}

<div class="container content-panel text-center animate__animated animate__fadeIn">
    <h1 class="text-center mb-4">Hoo-factor authentication required</h1>
    <h5 class="mb-4">Enter the code you received to continue</h5>
    <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
        <div class="row d-flex justify-content-center text-center mx-auto w-75">
            <div class="form-group">
                <input asp-for="Input.TwoFactorCode" class="form-control" aria-required="true" />
            </div>
        </div>
        <div class="row mt-2 d-flex justify-content-center mx-auto">
            <div class="col d-inline">
                <div role="button" tabindex="0" onclick="identitySubmit(this)" class="site-option option-button material-symbols-outlined align-items-center justify-content-center box-shadow" title="Continue">keyboard_double_arrow_right</div>
                <br />
                <span class="option-tip">Continue</span>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script type="text/javascript" src="~/js/identity.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
}