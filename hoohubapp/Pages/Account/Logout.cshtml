@page
@model LogoutModel
@{
    ViewData["Title"] = "Hootbye";
}

<div class="container content-panel text-center animate__animated animate__fadeIn">
    <h1 class="text-center mb-4">Hootbye...</h1>
    <br />
    <form id="logout-form" class="form-inline" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index")" method="post">
    </form>
    <img id="comic-display" class="d-block m-auto mb-2 mt-2 athena" style="max-height: 50vh" src="~/img/hootbye.png" asp-append-version=true />
    <h5 class="text-center mt-4">Logging out..</h5>
    <div class="loader mt-2 mb-2"></div>
</div>

@section Scripts {
    <script src="~/js/logout.js" asp-append-version="true"></script>
}