@page
@model hoohub.Pages.CookiesModel
@{
    ViewData["Title"] = "Cookies";
}

<div class="container animate__animated animate__fadeIn">
    <div class="row w-75 mx-auto">
        <div class="col">
            <h1 class="mt-2">Cookies</h1>
            <br />
            <h3 class="mb-4">What are cookies?</h3>
            <p>
                Cookies are small files created by websites that are used to store information about a website in your browser and on your device.
                <br /><br />
                Many websites and services take advantage of cookies to manage preferences, sessions, for security reasons and for marketing or advertising purposes.
            </p>
            <hr />
            <h3 class="mb-4">How do we use cookies?</h3>
            <p>
                HooHub only uses cookies for essential site functionality and for security purposes such as session management for authorised users. HooHub does not use cookies for advertising, marketing or for any other material or financial gain.
                <br /><br />
                By using HooHub, you consent to the use of only those cookies deemed essential for the correct functionality of HooHub as outlined above.
                <br /><br />
                In the event HooHub extends or expands upon our use of cookies for marketing, advertising or any other purposes, HooHub will endeavour to ensure users are able to make an informed choice on said cookies prior to their use.
            </p>
        </div>
        <div class="col d-flex align-items-center">
            <img class="comic-display mx-auto athena" style="max-width: 45vh" src="~/img/hookie.png" alt="Athena enjoying her cookies (not the web kind)"/>
        </div>
    </div>
    <div class="row mt-4 d-flex justify-content-center mx-auto">
        <div class="col-auto mx-auto">
            <a asp-page="/Index">
                <div role="button" tabindex="0" class="site-option option-button material-symbols-outlined align-items-center justify-content-center box-shadow" title="Home">keyboard_double_arrow_right</div>
            </a>
            <br />
            <span class="option-tip">Got it!</span>
        </div>
    </div>
</div>


